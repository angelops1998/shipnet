@model List<shipnet.Models.Materia>
@{
    ViewData["Title"] = "Materias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Materias</h2>
    <a asp-action="Crear" class="btn btn-primary">Nueva materia</a>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Codigo</td>
                    <td>@m.Nombre</td>
                    <td class="text-end">
                        <a asp-action="Eliminar" asp-route-id="@m.Id" class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Eliminar @m.Nombre?')">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>