@model List<ShipNetMvc.Models.EquipoDto>
@{
    ViewData["Title"] = "Equipos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Equipos del laboratorio</h2>
    <a asp-action="Crear" class="btn btn-primary">Nuevo equipo</a>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>MAC</th>
                <th>Ubicación</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Codigo</td>
                    <td><code>@e.MacAddress</code></td>
                    <td>@e.Ubicacion</td>
                    <td class="text-end">
                        <a asp-action="Eliminar" asp-route-id="@e.Id" class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Eliminar @e.Codigo?')">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>