@model List<ShipNetMvc.Models.SesionAsistenciaDto>
@{
    ViewData["Title"] = "Marcar Asistencia";
    var mac = ViewBag.Mac as string ?? "00:00:00:00:00:00";
    var miMateria = ViewBag.MiMateria as ShipNetMvc.Models.MiMateriaDto;
    var gruposDisponibles = ViewBag.GruposDisponibles as List<ShipNetMvc.Models.GrupoDto> ?? new List<ShipNetMvc.Models.GrupoDto>();

    var inscripciones = miMateria?.Inscripciones ?? new List<ShipNetMvc.Models.InscripcionMateriaDto>();
    // Si no vino la lista pero tiene grupo principal (compatibilidad)
    if (!inscripciones.Any() && miMateria?.Grupo != null)
    {
        inscripciones.Add(new ShipNetMvc.Models.InscripcionMateriaDto
        {
            GrupoId = miMateria.Grupo.Id,
            GrupoNombre = miMateria.Grupo.Nombre,
            Modulo = miMateria.Grupo.Modulo,
            Turno = miMateria.Grupo.Turno,
            Activo = miMateria.Grupo.Activo,
            Materia = miMateria.Grupo.Materia,
            Docente = miMateria.Grupo.Docente
        });
    }

    var turnosOcupados = miMateria?.TurnosOcupados ?? inscripciones.Where(i => !string.IsNullOrWhiteSpace(i.Turno)).Select(i => i.Turno.Trim()).ToList();
    int totalInscritas = inscripciones.Count;
    bool limite7Alcanzado = totalInscritas >= 7;
}

<!-- ENCABEZADO UPDS -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span class="badge bg-primary rounded-pill px-3 py-1">UPDS Presencial</span>
            <span class="badge bg-info text-dark rounded-pill px-3 py-1">@UpdsCalendario.ModuloActual.Nombre</span>
            @if (!string.IsNullOrEmpty(miMateria?.Carrera))
            {
                <span class="badge bg-secondary-subtle text-body border rounded-pill px-3 py-1">
                    <i class="bi bi-mortarboard me-1"></i>@miMateria.Carrera (@miMateria.Semestre° Semestre)
                </span>
            }
        </div>
        <h2 class="fw-bold mb-0" style="color: var(--upds-navy);">Control de Asistencia de Laboratorio</h2>
        <p class="text-muted mb-0">
            Inscripción modular: <strong>Máx. 1 materia por turno</strong> &bull; <strong>Hasta 7 materias por semestre</strong> &bull; Validación por MAC.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <span class="badge bg-body-secondary text-body border p-2" title="Dirección MAC del dispositivo">
            📡 Dispositivo detectado: <code class="fw-bold text-primary">@mac</code>
        </span>
        @if (!string.IsNullOrEmpty(miMateria?.MacAddress))
        {
            <span class="badge @(miMateria.MacAddress == mac ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning border border-warning") p-2">
                🔒 MAC en BD: <code class="fw-bold">@miMateria.MacAddress</code>
                @(miMateria.MacAddress == mac ? " (✓ Autorizada)" : " (⚠ No coincide)")
            </span>
        }
        else
        {
            <span class="badge bg-secondary-subtle text-muted border p-2">
                ⏳ Tu cuenta aún no tiene MAC vinculada en BD
            </span>
        }
    </div>
</div>

<!-- SECCIÓN: MIS MATERIAS INSCRITAS -->
<div class="card shadow-sm mb-4 border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center py-3 gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-journal-bookmark-fill fs-5"></i>
            <h5 class="fw-bold mb-0">Mis Materias Inscritas este Semestre</h5>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(limite7Alcanzado ? "bg-warning text-dark" : "bg-info text-dark") fs-6 px-3 py-1 rounded-pill">
                @totalInscritas / 7 Materias inscritas
            </span>
            @if (!limite7Alcanzado)
            {
                <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#inscribirCollapse">
                    <i class="bi bi-plus-circle me-1"></i> Inscribir otra materia
                </button>
            }
        </div>
    </div>
    <div class="card-body p-4">
        @if (inscripciones.Any())
        {
            <div class="row g-3">
                @foreach (var ins in inscripciones)
                {
                    // Buscar si hay sesión de asistencia abierta hoy para este grupo
                    var sesionAbierta = Model.FirstOrDefault(s => s.GrupoId == ins.GrupoId);

                    <div class="col-lg-6">
                        <div class="card h-100 border @(sesionAbierta != null ? "border-success shadow-sm" : "border-secondary-subtle") rounded-3">
                            <div class="card-header d-flex justify-content-between align-items-center py-2 @(sesionAbierta != null ? "bg-success-subtle" : "bg-body-secondary")">
                                <span class="badge bg-primary">
                                    <i class="bi bi-clock me-1"></i>Turno: @(ins.Turno ?? "Sin turno")
                                </span>
                                @if (sesionAbierta != null)
                                {
                                    <span class="badge bg-success"><i class="bi bi-broadcast me-1"></i>¡Clase Abierta Hoy!</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1"></i>Clase no iniciada</span>
                                }
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="fw-bold mb-1 text-primary">@(ins.Materia?.Nombre ?? "Materia")</h5>
                                    <div class="text-muted small mb-2">
                                        <strong>Paralelo:</strong> @ins.GrupoNombre &nbsp;|&nbsp;
                                        <strong>Módulo:</strong> @ins.Modulo &nbsp;|&nbsp;
                                        <strong>Semestre:</strong> @(ins.Materia?.Semestre ?? 1)°
                                    </div>
                                    <div class="text-muted small mb-3">
                                        <i class="bi bi-person-badge me-1"></i>Docente: 
                                        @(ins.Docente != null ? $"{ins.Docente.Nombre} {ins.Docente.Apellido}" : "Asignado por facultad")
                                    </div>
                                </div>

                                <div class="pt-2 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    @if (sesionAbierta != null)
                                    {
                                        <form method="post" asp-action="Marcar">
                                            <input type="hidden" name="sesionId" value="@sesionAbierta.Id" />
                                            <button type="submit" class="btn btn-success fw-bold px-3">
                                                <i class="bi bi-check2-circle me-1"></i> Marcar Asistencia
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                            <i class="bi bi-clock me-1"></i> Esperando al docente
                                        </button>
                                    }

                                    <form method="post" asp-action="RetirarMateria" onsubmit="return confirm('¿Seguro que deseas retirar la materia @(ins.Materia?.Nombre)? Se liberará el turno @(ins.Turno) para que puedas inscribir otra.')">
                                        <input type="hidden" name="grupoId" value="@ins.GrupoId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Dar de baja de esta materia y liberar el turno">
                                            <i class="bi bi-trash3 me-1"></i> Retirar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0 d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-1">Aún no tienes materias inscritas para este semestre.</h6>
                    <p class="mb-0 small">
                        En la UPDS puedes inscribir <strong>hasta 7 materias por semestre</strong>, con un máximo de <strong>1 materia por turno</strong> (Mañana, Tarde, Noche, etc.). Utiliza el formulario inferior para seleccionar tu primera materia.
                    </p>
                </div>
            </div>
        }

        <!-- FORMULARIO COLAPSABLE DE INSCRIPCIÓN -->
        <div class="collapse @(!inscripciones.Any() ? "show" : "") mt-4 pt-3 border-top" id="inscribirCollapse">
            @if (limite7Alcanzado)
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> <strong>Límite de 7 materias alcanzado:</strong> Ya tienes 7 materias inscritas en este semestre. Para cambiar o inscribir una distinta, retira previamente una de tus materias actuales.
                </div>
            }
            else
            {
                <h6 class="fw-bold text-primary mb-2">
                    <i class="bi bi-plus-circle-dotted me-1"></i> Inscribir Nueva Materia (Cupos disponibles: @(7 - totalInscritas) de 7):
                </h6>
                <p class="text-muted small mb-3">
                    Solo puedes tener 1 materia por turno. Los turnos donde ya tienes una materia inscrita están bloqueados para evitar choques de horario.
                </p>

                <form asp-action="InscribirMateria" method="post" class="row g-2 align-items-center">
                    <div class="col-md-8">
                        <select name="grupoId" class="form-select" required>
                            <option value="">-- Selecciona una Materia y Turno disponible --</option>
                            @foreach (var carreraGroup in gruposDisponibles.GroupBy(g => g.Materia?.Carrera?.Nombre ?? "Tronco Común").OrderBy(cg => cg.Key))
                            {
                                <optgroup label="🎓 Carrera: @carreraGroup.Key">
                                    @foreach (var g in carreraGroup.OrderBy(x => x.Materia?.Semestre).ThenBy(x => x.Materia?.Nombre))
                                    {
                                        bool yaInscritoEnEsteGrupo = inscripciones.Any(i => i.GrupoId == g.Id);
                                        bool yaInscritoEnEstaMateria = inscripciones.Any(i => i.Materia?.Id == g.MateriaId);
                                        bool turnoOcupado = !string.IsNullOrWhiteSpace(g.Turno) && turnosOcupados.Any(t => string.Equals(t?.Trim(), g.Turno?.Trim(), StringComparison.OrdinalIgnoreCase));

                                        if (yaInscritoEnEsteGrupo)
                                        {
                                            <option value="@g.Id" disabled>
                                                ✓ YA INSCRITO: @(g.Materia?.Nombre) [@g.Turno]
                                            </option>
                                        }
                                        else if (yaInscritoEnEstaMateria)
                                        {
                                            <option value="@g.Id" disabled>
                                                ⛔ YA CURSAS ESTA MATERIA: @(g.Materia?.Nombre) [@g.Turno]
                                            </option>
                                        }
                                        else if (turnoOcupado)
                                        {
                                            <option value="@g.Id" disabled>
                                                ⛔ TURNO OCUPADO: @(g.Materia?.Nombre) [@g.Turno] (Choque de horario)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@g.Id">
                                                @(g.Materia?.Nombre) (@(g.Materia?.Semestre)° Semestre) &mdash; Docente: @(g.Docente?.Nombre) @(g.Docente?.Apellido) [@g.Turno]
                                            </option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Confirmar Inscripción
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<!-- OTRAS SESIONES ABIERTAS EN EL LABORATORIO (SI CORRESPONDE) -->
@{
    var grupoIdsInscritos = inscripciones.Select(i => i.GrupoId).ToHashSet();
    var otrasSesiones = Model.Where(s => !grupoIdsInscritos.Contains(s.GrupoId)).ToList();
}
@if (otrasSesiones.Any())
{
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-body-secondary py-3">
            <h6 class="text-body fw-bold mb-0">
                <i class="bi bi-broadcast me-1 text-primary"></i> Otras sesiones activas en el laboratorio de cómputo:
            </h6>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                @foreach (var s in otrasSesiones)
                {
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 bg-body-tertiary">
                            <div class="card-body p-3">
                                <h6 class="fw-bold mb-1 text-primary">@(s.Grupo?.Materia?.Nombre ?? "Materia") - @(s.Grupo?.Nombre)</h6>
                                <div class="text-muted small mb-2">
                                    <strong>Turno:</strong> @(s.Grupo?.Turno ?? "—") &nbsp;|&nbsp;
                                    <strong>Docente:</strong> @(s.Grupo?.Docente?.Nombre) @(s.Grupo?.Docente?.Apellido)<br />
                                    <strong>Apertura:</strong> @s.HoraInicio?.ToString(@"hh\:mm")
                                </div>
                                <form method="post" asp-action="Marcar">
                                    <input type="hidden" name="sesionId" value="@s.Id" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Marcar asistencia en esta clase
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-action="Historial" class="btn btn-outline-secondary">
        <i class="bi bi-clock-history me-1"></i> Ver mi historial acumulado de asistencias
    </a>
</div>