@model List<ShipNetMvc.Models.SesionAsistenciaDto>
@{
    ViewData["Title"] = "Sesiones de asistencia";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Sesiones de asistencia</h2>
    <a asp-action="Abrir" class="btn btn-primary">Abrir nueva sesión</a>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Grupo</th>
                <th>Fecha</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Grupo.Materia?.Nombre - @s.Grupo.Nombre</td>
                    <td>@s.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@s.HoraInicio?.ToString(@"hh\:mm")</td>
                    <td>@s.HoraFin?.ToString(@"hh\:mm")</td>
                    <td>
                        @if (s.Abierta)
                        {
                            <span class="badge bg-success">Abierta</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Cerrada</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-secondary btn-sm">Ver registros</a>
                        @if (s.Abierta)
                        {
                            <a asp-action="Cerrar" asp-route-id="@s.Id" class="btn btn-danger btn-sm">Cerrar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>