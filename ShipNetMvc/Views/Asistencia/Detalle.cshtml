@model ShipNetMvc.Models.SesionAsistenciaDto
@{
    ViewData["Title"] = "Registros de asistencia";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
    <div>
        <h2>@(Model.Grupo.Materia != null ? Model.Grupo.Materia.Nombre + " - " : "")@Model.Grupo.Nombre</h2>
        <p class="text-muted mb-0">
            <strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy") &nbsp;|&nbsp;
            <strong>Inicio:</strong> @(Model.HoraInicio?.ToString(@"hh\:mm") ?? "—") &nbsp;|&nbsp;
            <strong>Fin:</strong> @(Model.HoraFin?.ToString(@"hh\:mm") ?? "—") &nbsp;|&nbsp;
            <strong>Estado:</strong>
            @if (Model.Abierta)
            {
                <span class="badge bg-success">Abierta</span>
            }
            else
            {
                <span class="badge bg-secondary">Cerrada</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" onclick="exportarCSV()" class="btn btn-outline-success btn-sm">Exportar CSV</button>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm">Imprimir</button>
        @if (Model.Abierta)
        {
            <a asp-action="Cerrar" asp-route-id="@Model.Id" class="btn btn-danger btn-sm"
               onclick="return confirm('¿Seguro que deseas cerrar esta sesión?')">Cerrar sesión</a>
        }
        <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
    </div>
</div>


<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Estudiante</th>
                <th>CI</th>
                <th>Equipo</th>
                <th>Hora</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RegistrosAsistencia == null || !Model.RegistrosAsistencia.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        No hay registros de asistencia en esta sesión todavía.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var r in Model.RegistrosAsistencia)
                {
                    <tr>
                        <td>@r.Estudiante?.Nombre @r.Estudiante?.Apellido</td>
                        <td>@r.Estudiante?.CI</td>
                        <td>@(r.Equipo?.Codigo ?? "—")</td>
                        <td>@r.HoraRegistro.ToString(@"hh\:mm")</td>
                        <td>
                            <span class="badge @(r.Estado == "Presente" ? "bg-success" : "bg-warning text-dark")">@r.Estado</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>

@section Scripts {
    <script>
        function exportarCSV() {
            var rows = document.querySelectorAll("table tr");
            var csv = [];
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) {
                    var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, "").trim();
                    row.push('"' + data.replace(/"/g, '""') + '"');
                }
                csv.push(row.join(","));
            }
            var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            var downloadLink = document.createElement("a");
            downloadLink.download = "Asistencia_@Model.Fecha.ToString("yyyyMMdd")_@(Model.Grupo?.Nombre ?? "Grupo").csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}