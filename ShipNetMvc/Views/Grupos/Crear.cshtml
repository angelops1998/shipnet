@model ShipNetMvc.Models.GrupoDto
@{
    ViewData["Title"] = "Nuevo grupo";
}

<div class="card">
    <div class="card-header">Nuevo grupo</div>
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="Nombre">Nombre</label>
                    <input class="form-control" asp-for="Nombre" placeholder="Grupo A" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="MateriaId">Materia</label>
                    <select class="form-select" asp-for="MateriaId" asp-items="ViewBag.Materias"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="DocenteId">Docente</label>
                    <select class="form-select" asp-for="DocenteId" asp-items="ViewBag.Docentes"></select>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>