@model ShipNetMvc.Models.GrupoDto
@{
    ViewData["Title"] = "Editar Asignación Modular";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-top border-4 border-primary">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary">Editar Asignación</span>
                    <h5 class="fw-bold mb-0 text-primary">Modificar Materia y Grupo</h5>
                </div>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="MateriaId">Materia Académica</label>
                            <select class="form-select" asp-for="MateriaId" asp-items="ViewBag.Materias" required></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Docente Asignado</label>
                            @if (User.IsInRole("Docente"))
                            {
                                <input type="hidden" asp-for="DocenteId" />
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-primary"><i class="bi bi-person-badge"></i></span>
                                    <input type="text" class="form-control bg-light fw-bold text-dark" value="@(Model.Docente?.Nombre) @(Model.Docente?.Apellido) (Tú)" readonly disabled />
                                </div>
                                <div class="form-text text-muted small">Tu asignación docente está vinculada a tu cuenta institucional.</div>
                            }
                            else
                            {
                                <select class="form-select" asp-for="DocenteId" asp-items="ViewBag.Docentes" required></select>
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" asp-for="Nombre">Nombre del Grupo / Paralelo</label>
                            <input class="form-control" asp-for="Nombre" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" asp-for="Modulo">Módulo Académico UPDS</label>
                            <select class="form-select" asp-for="Modulo" asp-items="ViewBag.Modulos" required></select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" asp-for="Turno">Turno / Horario</label>
                            <select class="form-select" asp-for="Turno" asp-items="ViewBag.Turnos" required></select>
                        </div>

                        <div class="col-12 mt-3">
                            <div class="form-check form-switch p-3 border rounded bg-light">
                                <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="Activo" id="activoCheck" />
                                <label class="form-check-label fw-bold" for="activoCheck">
                                    Materia Activa para este Mes (Módulo en curso)
                                </label>
                                <div class="form-text text-muted small ms-1">
                                    Desmárcalo cuando concluya el mes para dar paso a la materia del siguiente módulo.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
