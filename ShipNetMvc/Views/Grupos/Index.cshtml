@model List<ShipNetMvc.Models.GrupoDto>
@{
    ViewData["Title"] = "Grupos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Grupos</h2>
    <a asp-action="Crear" class="btn btn-primary">Nuevo grupo</a>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Grupo</th>
                <th>Materia</th>
                <th>Docente</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.Nombre</td>
                    <td>@g.Materia?.Nombre</td>
                    <td>@g.Docente?.Nombre @g.Docente?.Apellido</td>
                    <td class="text-end">
                        <a asp-action="Eliminar" asp-route-id="@g.Id" class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Eliminar @g.Nombre?')">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>