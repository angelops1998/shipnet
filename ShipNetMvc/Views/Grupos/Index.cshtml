@model List<ShipNetMvc.Models.GrupoDto>
@{
    ViewData["Title"] = "Asignación de Materias y Docentes";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary rounded-pill px-3 py-1">Sistema Modular UPDS</span>
            <span class="badge bg-info text-dark rounded-pill px-3 py-1">1 Materia por Mes</span>
        </div>
        <h2 class="fw-bold mb-0" style="color: var(--upds-navy);">Asignación de Materias y Docentes</h2>
        <p class="text-muted mb-0">Configura la materia que imparte cada docente según el calendario de módulos y turnos.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="Calendario" class="btn btn-outline-primary btn-sm">📅 Calendario 2026</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Crear" class="btn btn-primary btn-sm">+ Nueva Asignación</a>
        }
    </div>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Materia</th>
                <th>Paralelo</th>
                <th>Docente</th>
                <th>Módulo Académico</th>
                <th>Turno</th>
                <th>Estado este Mes</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay grupos ni materias asignadas todavía.</td>
                </tr>
            }
            else
            {
                @foreach (var g in Model)
                {
                    <tr class="@(g.Activo ? "" : "opacity-75")">
                        <td>
                            <strong class="text-primary">@(g.Materia?.Nombre ?? "Materia")</strong>
                            <div class="small text-muted">@(g.Materia?.Codigo ?? "—")</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@g.Nombre</span>
                        </td>
                        <td>
                            <strong>@(g.Docente?.Nombre) @(g.Docente?.Apellido)</strong>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(g.Modulo)</span>
                        </td>
                        <td>
                            <small class="text-muted">@(g.Turno)</small>
                        </td>
                        <td>
                            @if (g.Activo)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">🟢 Activa (En curso)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">⏸️ Inactiva</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleActivo" asp-route-id="@g.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(g.Activo ? "btn-outline-warning text-dark" : "btn-outline-success") me-1">
                                    @(g.Activo ? "Desactivar" : "Activar este mes")
                                </button>
                            </form>
                            <a asp-action="Editar" asp-route-id="@g.Id" class="btn btn-secondary btn-sm me-1">Editar</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Eliminar" asp-route-id="@g.Id" class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('¿Eliminar la asignación de @g.Nombre?')">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="mt-4">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Volver al panel central</a>
    </div>
}