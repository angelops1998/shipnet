@model ShipNetMvc.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registro de estudiante";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Registro de estudiante</div>
            <div class="card-body">
                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Nombre">Nombre</label>
                            <input class="form-control" asp-for="Nombre" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Apellido">Apellido</label>
                            <input class="form-control" asp-for="Apellido" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="CI">CI</label>
                            <input class="form-control" asp-for="CI" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Email">Correo</label>
                            <input class="form-control" asp-for="Email" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="Password">Contraseña</label>
                            <input class="form-control" asp-for="Password" type="password" />
                        </div>
                    </div>
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Registrarme</button>
                        <a asp-action="Login" class="btn btn-secondary">Ya tengo cuenta</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>