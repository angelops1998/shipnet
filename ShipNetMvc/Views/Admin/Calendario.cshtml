@model List<ShipNetMvc.Models.ModuloAcademico>
@{
    ViewData["Title"] = "Calendario Académico Presencial 2026";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-primary px-3 py-2">UPDS Presencial</span>
            <span class="badge bg-info text-dark px-3 py-2">Gestión 2026</span>
        </div>
        <h2 class="fw-bold mb-0" style="color: var(--upds-navy);">Calendario Académico Modular</h2>
        <p class="text-muted mb-0">Modalidad por Competencias &mdash; Cada estudiante cursa 1 materia por módulo mensual.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="javascript:window.print()" class="btn btn-outline-secondary btn-sm">Imprimir calendario</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Index" class="btn btn-primary btn-sm">Volver al Panel</a>
        }
    </div>
</div>

<div class="card p-3 mb-4 border-start border-4 border-info bg-light">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h5 class="fw-bold text-primary mb-1">📍 Módulo Actual en Curso: @UpdsCalendario.ModuloActual.Nombre (@UpdsCalendario.ModuloActual.Mes)</h5>
            <div class="text-muted small">
                <strong>Vigencia:</strong> Desde el @UpdsCalendario.ModuloActual.FechaInicio.ToString("dd 'de' MMMM 'de' yyyy") hasta el @UpdsCalendario.ModuloActual.FechaFin.ToString("dd 'de' MMMM 'de' yyyy").
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 text-center">
            <span class="badge bg-primary p-2">🔵 Inicio de módulo</span>
            <span class="badge bg-secondary p-2" style="background-color: #6b21a8 !important;">🟣 Conclusión de módulo</span>
            <span class="badge bg-danger p-2">🔴 Feriados</span>
            <span class="badge bg-warning text-dark p-2">🟡 Descansos / Ofertas</span>
        </div>
    </div>
</div>

<div class="upds-calendario-grid">
    @foreach (var mod in Model)
    {
        <div class="modulo-card @(mod.EsModuloActual ? "modulo-activo" : "")">
            <div class="modulo-header">
                <span class="modulo-num">@mod.Nombre</span>
                <span class="badge @(mod.EsModuloActual ? "bg-primary" : "bg-light text-dark")">@mod.Mes</span>
            </div>

            <div class="modulo-fechas">
                <div class="mb-1">
                    <span class="modulo-tag-inicio">Inicio:</span>
                    <strong>@mod.FechaInicio.ToString("dd/MM/yyyy")</strong>
                </div>
                <div>
                    <span class="modulo-tag-fin">Conclusión:</span>
                    <strong>@mod.FechaFin.ToString("dd/MM/yyyy")</strong>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mod.Feriados))
            {
                <div class="mt-2 pt-2 border-top text-muted small">
                    <span class="text-danger fw-bold">Feriados:</span> @mod.Feriados
                </div>
            }

            <div class="mt-2 text-muted small">
                <em>@mod.Detalle</em>
            </div>

            @if (mod.EsModuloActual)
            {
                <div class="mt-3">
                    @if (User.IsInRole("Estudiante"))
                    {
                        <a asp-controller="Asistencia" asp-action="Marcar" class="btn btn-sm btn-upds-cyan w-100">Ver mi materia de este mes</a>
                    }
                    else if (User.IsInRole("Docente"))
                    {
                        <a asp-controller="Grupos" asp-action="Index" class="btn btn-sm btn-primary w-100">Activar mi materia modular</a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Grupos" asp-action="Index" class="btn btn-sm btn-primary w-100">Gestionar materias del módulo</a>
                    }
                </div>
            }
        </div>
    }
</div>
