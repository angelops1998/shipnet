@model List<ShipNetMvc.Models.SesionAsistenciaDto>
@{
    ViewData["Title"] = "Supervisión Global de Asistencias";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger rounded-pill px-3 py-1">Auditoría Académica</span>
            <span class="badge bg-primary rounded-pill px-3 py-1">UPDS</span>
        </div>
        <h2 class="fw-bold mb-0" style="color: var(--upds-navy);">Sesiones de Asistencia en Laboratorios</h2>
        <p class="text-muted mb-0">Control general de clases impartidas, docentes responsables y estudiantes presentes verificados por MAC.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-secondary btn-sm">Volver al Panel</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Materia / Módulo</th>
                <th>Docente</th>
                <th>Horario Apertura</th>
                <th>Estado</th>
                <th>Estudiantes Presentes</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No hay sesiones de asistencia registradas en el sistema.</td>
                </tr>
            }
            else
            {
                @foreach (var s in Model)
                {
                    var countPresentes = s.RegistrosAsistencia?.Count ?? 0;
                    <tr>
                        <td>
                            <strong>@s.Fecha.ToString("dd/MM/yyyy")</strong>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(s.Grupo?.Materia?.Nombre ?? "Materia")</span>
                            <div class="small text-muted">@(s.Grupo?.Nombre) &bull; @(s.Grupo?.Modulo ?? "Módulo")</div>
                        </td>
                        <td>
                            @(s.Grupo?.Docente != null ? $"{s.Grupo.Docente.Nombre} {s.Grupo.Docente.Apellido}" : "Docente")
                        </td>
                        <td>
                            @s.HoraInicio?.ToString(@"hh\:mm")
                            @if (s.HoraFin.HasValue)
                            {
                                <small class="text-muted"> a @s.HoraFin.Value.ToString(@"hh\:mm")</small>
                            }
                        </td>
                        <td>
                            @if (s.Abierta)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2">🟢 En curso</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2">Cerrada</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(countPresentes > 0 ? "bg-primary" : "bg-light text-dark border") rounded-pill px-3 py-2">
                                @countPresentes @(countPresentes == 1 ? "presente" : "presentes")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Asistencia" asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
                                Ver lista de asistentes
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
