@model List<ShipNetMvc.Models.EvaluacionDto>
@{
    ViewData["Title"] = "Supervisión Global de Exámenes";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-danger rounded-pill px-3 py-1">Auditoría Académica</span>
            <span class="badge bg-primary rounded-pill px-3 py-1">UPDS</span>
        </div>
        <h2 class="fw-bold mb-0" style="color: var(--upds-navy);">Exámenes y Evaluaciones del Laboratorio</h2>
        <p class="text-muted mb-0">Revisión centralizada de evaluaciones programadas, participación de estudiantes y actas de notas.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-secondary btn-sm">Volver al Panel</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-shipnet align-middle">
        <thead>
            <tr>
                <th>Evaluación</th>
                <th>Materia / Módulo</th>
                <th>Docente</th>
                <th>Fecha y Horario</th>
                <th>Límite</th>
                <th>Participantes</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No se han registrado evaluaciones en el sistema.</td>
                </tr>
            }
            else
            {
                @foreach (var ev in Model)
                {
                    var countIntentos = ev.IntentosEvaluacion?.Count ?? 0;
                    <tr>
                        <td>
                            <strong>@ev.Titulo</strong>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">@(ev.Grupo?.Materia?.Nombre ?? "Materia")</span>
                            <div class="small text-muted">@(ev.Grupo?.Nombre) &bull; @(ev.Grupo?.Modulo ?? "Módulo")</div>
                        </td>
                        <td>
                            @(ev.Grupo?.Docente != null ? $"{ev.Grupo.Docente.Nombre} {ev.Grupo.Docente.Apellido}" : "Docente")
                        </td>
                        <td>
                            <div>@ev.FechaInicio.ToString("dd/MM/yyyy")</div>
                            <small class="text-muted">@ev.FechaInicio.ToString("HH:mm") a @ev.FechaFin.ToString("HH:mm")</small>
                        </td>
                        <td>@ev.DuracionMinutos min</td>
                        <td>
                            <span class="badge @(countIntentos > 0 ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2">
                                @countIntentos @(countIntentos == 1 ? "alumno" : "alumnos")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-controller="Evaluaciones" asp-action="Detalle" asp-route-id="@ev.Id" class="btn btn-sm btn-primary me-1">
                                Ver acta de notas
                            </a>
                            <a asp-controller="Evaluaciones" asp-action="Eliminar" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('¿Está seguro de eliminar esta evaluación?')">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
