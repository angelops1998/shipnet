@model List<ShipNetMvc.Models.DocenteDto>
@{
    ViewData["Title"] = "Gestión de Docentes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-badge me-2" style="color:var(--upds-azul)"></i>Docentes
            </h2>
            <p class="text-muted mb-0">Gestión de planta docente registrada en el sistema</p>
        </div>
        <a href="@Url.Action("Crear", "Docentes")" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-person-plus"></i> Agregar Docente
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@TempData["TipoMensaje"] alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-@(TempData["TipoMensaje"]?.ToString() == "success" ? "check-circle" : TempData["TipoMensaje"]?.ToString() == "warning" ? "exclamation-triangle" : "x-circle") me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-auto">
            <div class="badge-stat px-4 py-3 rounded-3 d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#002855,#004080);color:white">
                <i class="bi bi-person-badge fs-4"></i>
                <div>
                    <div class="fw-bold fs-4">@Model.Count</div>
                    <small class="opacity-75">Docentes Registrados</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3 d-flex align-items-center gap-2">
            <i class="bi bi-table" style="color:var(--upds-azul)"></i>
            <strong>Lista de Docentes</strong>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Especialidad</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-badge fs-1 d-block mb-2 opacity-25"></i>
                                    No hay docentes registrados.
                                    <a href="@Url.Action("Crear", "Docentes")" class="d-block mt-2 text-primary">Agregar el primero</a>
                                </td>
                            </tr>
                        }
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge rounded-pill" style="background:var(--upds-azul)">@d.Id</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle" style="width:38px;height:38px;background:linear-gradient(135deg,var(--upds-azul),var(--upds-celeste));border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:.9rem;flex-shrink:0">
                                            @(d.Nombre.Length > 0 ? d.Nombre[0].ToString().ToUpper() : "")@(d.Apellido.Length > 0 ? d.Apellido[0].ToString().ToUpper() : "")
                                        </div>
                                        <div>
                                            <span class="fw-semibold">@d.Apellido, @d.Nombre</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.Email))
                                    {
                                        <a href="mailto:@d.Email" class="text-decoration-none text-muted small">
                                            <i class="bi bi-envelope me-1"></i>@d.Email
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrEmpty(d.Telefono) ? "—" : d.Telefono)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(d.Especialidad))
                                    {
                                        <span class="badge rounded-pill bg-light text-dark border">@d.Especialidad</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Editar", "Docentes", new { id = d.Id })"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Eliminar", "Docentes", new { id = d.Id })"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('¿Eliminar al docente @d.Nombre @d.Apellido? Esta acción también eliminará su cuenta de usuario.')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
