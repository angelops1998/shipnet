@model ShipNetMvc.Models.EvaluacionDto
@using System.Text.Json
@{
    ViewData["Title"] = "Rendir: " + (Model?.Titulo ?? "Evaluación");
    int intentoId = ViewBag.IntentoId ?? 0;
    string mac = ViewBag.Mac ?? "";

    List<ShipNetMvc.Models.PreguntaOpcionMultiple> preguntas = new();
    if (!string.IsNullOrWhiteSpace(Model?.PreguntasJson))
    {
        try
        {
            preguntas = JsonSerializer.Deserialize<List<ShipNetMvc.Models.PreguntaOpcionMultiple>>(Model.PreguntasJson) ?? new();
        }
        catch { }
    }
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center py-3 gap-2">
        <div>
            <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>@(Model?.Titulo ?? "Evaluación")</h4>
            <small class="text-white-50">@(Model?.Grupo?.Materia?.Nombre ?? "Materia") &bull; @(Model?.Grupo?.Nombre ?? "Grupo")</small>
        </div>
        <div class="text-end d-flex align-items-center gap-2">
            <span class="badge bg-success py-2 px-3"><i class="bi bi-display me-1"></i>Equipo validado: <code>@mac</code></span>
            <span class="badge bg-warning text-dark fs-6 py-2 px-3" id="temporizador">
                <i class="bi bi-stopwatch me-1"></i> Tiempo: @(Model?.DuracionMinutos ?? 60):00
            </span>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-info py-2 mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-shield-check fs-4"></i>
            <div>
                <strong>Examen Seguro de Laboratorio UPDS:</strong> Tu intento está enlazado a esta terminal autorizada. Al presionar "Finalizar y entregar", se calculará y registrará tu calificación oficial.
            </div>
        </div>

        <form id="formEvaluacion" asp-action="Finalizar" method="post">
            <input type="hidden" name="intentoId" value="@intentoId" />
            <input type="hidden" name="puntaje" id="inputPuntaje" value="0" />

            @if (preguntas.Any())
            {
                int pNum = 0;
                @foreach (var p in preguntas)
                {
                    pNum++;
                    <div class="card mb-4 border shadow-sm bloque-pregunta" data-correcta="@p.Correcta">
                        <div class="card-header bg-body-tertiary fw-bold py-2 d-flex justify-content-between align-items-center">
                            <span>Pregunta @pNum de @preguntas.Count</span>
                            <span class="badge bg-secondary">Selección Múltiple</span>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <!-- Enunciado -->
                            @if (!string.IsNullOrWhiteSpace(p.Enunciado))
                            {
                                <h5 class="card-title mb-3">@p.Enunciado</h5>
                            }

                            <!-- Imagen de la pregunta si existe -->
                            @if (!string.IsNullOrWhiteSpace(p.ImagenUrl))
                            {
                                <div class="text-center my-3 p-2 bg-body-secondary-subtle rounded border">
                                    <img src="@p.ImagenUrl" class="img-fluid rounded shadow-sm bg-white p-1" style="max-height: 320px; object-fit: contain;" alt="Imagen de pregunta @pNum" />
                                </div>
                            }

                            <!-- Opciones A, B, C, D -->
                            <div class="row g-3 mt-1">
                                <!-- Opción A -->
                                <div class="col-md-6">
                                    <label class="opcion-container w-100 h-100 p-3 border rounded d-flex flex-column justify-content-between cursor-pointer" for="p@(pNum)_a">
                                        <div class="d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1 flex-shrink-0" type="radio" name="preg_@pNum" id="p@(pNum)_a" value="A" checked>
                                            <div>
                                                <strong class="text-primary me-1">A)</strong>
                                                <span>@p.OpcionA</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(p.ImagenA))
                                        {
                                            <div class="text-center mt-2 pt-2 border-top">
                                                <img src="@p.ImagenA" class="img-fluid rounded border bg-white p-1" style="max-height: 140px; object-fit: contain;" alt="Opción A" />
                                            </div>
                                        }
                                    </label>
                                </div>

                                <!-- Opción B -->
                                <div class="col-md-6">
                                    <label class="opcion-container w-100 h-100 p-3 border rounded d-flex flex-column justify-content-between cursor-pointer" for="p@(pNum)_b">
                                        <div class="d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1 flex-shrink-0" type="radio" name="preg_@pNum" id="p@(pNum)_b" value="B">
                                            <div>
                                                <strong class="text-primary me-1">B)</strong>
                                                <span>@p.OpcionB</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(p.ImagenB))
                                        {
                                            <div class="text-center mt-2 pt-2 border-top">
                                                <img src="@p.ImagenB" class="img-fluid rounded border bg-white p-1" style="max-height: 140px; object-fit: contain;" alt="Opción B" />
                                            </div>
                                        }
                                    </label>
                                </div>

                                <!-- Opción C -->
                                <div class="col-md-6">
                                    <label class="opcion-container w-100 h-100 p-3 border rounded d-flex flex-column justify-content-between cursor-pointer" for="p@(pNum)_c">
                                        <div class="d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1 flex-shrink-0" type="radio" name="preg_@pNum" id="p@(pNum)_c" value="C">
                                            <div>
                                                <strong class="text-primary me-1">C)</strong>
                                                <span>@p.OpcionC</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(p.ImagenC))
                                        {
                                            <div class="text-center mt-2 pt-2 border-top">
                                                <img src="@p.ImagenC" class="img-fluid rounded border bg-white p-1" style="max-height: 140px; object-fit: contain;" alt="Opción C" />
                                            </div>
                                        }
                                    </label>
                                </div>

                                <!-- Opción D -->
                                <div class="col-md-6">
                                    <label class="opcion-container w-100 h-100 p-3 border rounded d-flex flex-column justify-content-between cursor-pointer" for="p@(pNum)_d">
                                        <div class="d-flex align-items-start gap-2">
                                            <input class="form-check-input mt-1 flex-shrink-0" type="radio" name="preg_@pNum" id="p@(pNum)_d" value="D">
                                            <div>
                                                <strong class="text-primary me-1">D)</strong>
                                                <span>@p.OpcionD</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(p.ImagenD))
                                        {
                                            <div class="text-center mt-2 pt-2 border-top">
                                                <img src="@p.ImagenD" class="img-fluid rounded border bg-white p-1" style="max-height: 140px; object-fit: contain;" alt="Opción D" />
                                            </div>
                                        }
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    No se han configurado preguntas para esta evaluación.
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-body-tertiary rounded">
                <a asp-action="Disponibles" class="btn btn-outline-secondary" onclick="return confirm('¿Seguro que deseas salir? El tiempo seguirá transcurriendo.')">
                    <i class="bi bi-arrow-left me-1"></i> Salir sin entregar
                </a>
                <button type="button" onclick="calcularYEnviar()" class="btn btn-success btn-lg px-4 fw-bold">
                    <i class="bi bi-send-check me-1"></i> Finalizar y entregar evaluación
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }
    .opcion-container:hover {
        background-color: var(--bs-tertiary-bg);
        border-color: #0099da !important;
    }
    .opcion-container:has(input[type="radio"]:checked) {
        border-color: #002855 !important;
        background-color: rgba(0, 153, 218, 0.08);
        box-shadow: 0 0 0 2px rgba(0, 40, 85, 0.25);
    }
</style>

@section Scripts {
    <script>
        function calcularYEnviar() {
            if (!confirm("¿Estás seguro de que deseas finalizar y entregar la evaluación ahora?")) return;

            const bloques = document.querySelectorAll(".bloque-pregunta");
            let correctas = 0;

            bloques.forEach((bloque) => {
                const correcta = (bloque.getAttribute("data-correcta") || "").trim().toUpperCase();
                const radioSeleccionado = bloque.querySelector("input[type='radio']:checked");
                if (radioSeleccionado && radioSeleccionado.value.toUpperCase() === correcta) {
                    correctas++;
                }
            });

            const total = bloques.length;
            const puntaje = total > 0 ? Math.round((correctas / total) * 100) : 100;

            document.getElementById("inputPuntaje").value = puntaje;
            document.getElementById("formEvaluacion").submit();
        }

        // Temporizador regresivo
        var duracionMinutos = @(Model?.DuracionMinutos ?? 60);
        var segundos = duracionMinutos * 60;
        var timerElem = document.getElementById("temporizador");

        var interval = setInterval(function() {
            if (segundos <= 0) {
                clearInterval(interval);
                alert("El tiempo de la evaluación ha expirado. Entregando automáticamente...");
                calcularYEnviar();
            } else {
                segundos--;
                var m = Math.floor(segundos / 60);
                var s = segundos % 60;
                timerElem.innerHTML = '<i class="bi bi-stopwatch me-1"></i> Tiempo: ' + m + ":" + (s < 10 ? "0" : "") + s;
            }
        }, 1000);
    </script>
}
