@model ShipNetMvc.Models.EvaluacionDto
@using System.Text.Json
@{
    ViewData["Title"] = "Resultados de Evaluación";
    List<ShipNetMvc.Models.PreguntaOpcionMultiple> preguntas = new();
    if (!string.IsNullOrWhiteSpace(Model?.PreguntasJson))
    {
        try
        {
            preguntas = JsonSerializer.Deserialize<List<ShipNetMvc.Models.PreguntaOpcionMultiple>>(Model.PreguntasJson) ?? new();
        }
        catch { }
    }
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
    <div>
        <h2><i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>@(Model?.Titulo ?? "Evaluación")</h2>
        <p class="text-muted mb-0">
            <strong>Materia:</strong> @(Model?.Grupo?.Materia?.Nombre ?? "—") &nbsp;|&nbsp;
            <strong>Grupo:</strong> @(Model?.Grupo?.Nombre ?? "—") &nbsp;|&nbsp;
            <strong>Inicio:</strong> @(Model?.FechaInicio.ToString("dd/MM/yyyy HH:mm") ?? "—") &nbsp;|&nbsp;
            <strong>Fin:</strong> @(Model?.FechaFin.ToString("dd/MM/yyyy HH:mm") ?? "—") &nbsp;|&nbsp;
            <strong>Límite:</strong> @(Model?.DuracionMinutos ?? 0) min
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" onclick="exportarNotasCSV()" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar Notas (CSV/Excel)
        </button>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Imprimir acta
        </button>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-people me-2"></i>Estudiantes y Calificaciones</h5>
        <span class="badge bg-light text-primary">@(Model?.IntentosEvaluacion?.Count ?? 0) Registrados</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-shipnet align-middle mb-0">
                <thead>
                    <tr>
                        <th>Estudiante</th>
                        <th>C.I.</th>
                        <th>Equipo / MAC</th>
                        <th>Hora inicio</th>
                        <th>Hora fin</th>
                        <th>Calificación</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.IntentosEvaluacion == null || !Model.IntentosEvaluacion.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aún no hay estudiantes que hayan rendido esta evaluación.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var i in Model.IntentosEvaluacion)
                        {
                            <tr>
                                <td><strong>@i.Estudiante?.Nombre @i.Estudiante?.Apellido</strong></td>
                                <td>@(i.Estudiante?.CI ?? "—")</td>
                                <td>
                                    <code>@(i.Equipo?.Codigo ?? "PC")</code>
                                    <small class="text-muted">(@(i.Equipo?.MacAddress ?? "—"))</small>
                                </td>
                                <td>@i.FechaInicio.ToString("HH:mm:ss")</td>
                                <td>@(i.FechaFin?.ToString("HH:mm:ss") ?? "En curso...")</td>
                                <td>
                                    @if (i.Puntaje.HasValue)
                                    {
                                        <span class="badge @(i.Puntaje >= 51 ? "bg-success" : "bg-danger") fs-6">
                                            @i.Puntaje.Value.ToString("0.0") / 100
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (preguntas.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-body-secondary d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapsePreguntas" style="cursor: pointer;">
            <h5 class="mb-0 text-primary">
                <i class="bi bi-journal-text me-2"></i>Banco de Preguntas del Examen (@preguntas.Count preguntas)
            </h5>
            <span class="text-muted small"><i class="bi bi-chevron-down"></i> Clic para ver / ocultar</span>
        </div>
        <div class="collapse show" id="collapsePreguntas">
            <div class="card-body p-4">
                <div class="row g-4">
                    @foreach (var p in preguntas)
                    {
                        <div class="col-12">
                            <div class="card border p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold fs-6">Pregunta @p.Numero</span>
                                    <span class="badge bg-success">Correcta: Opción @p.Correcta</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(p.Enunciado))
                                {
                                    <p class="mb-2 fs-6">@p.Enunciado</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(p.ImagenUrl))
                                {
                                    <div class="text-center my-2 p-2 bg-body-tertiary rounded">
                                        <img src="@p.ImagenUrl" class="img-fluid rounded border bg-white p-1" style="max-height: 200px; object-fit: contain;" alt="Pregunta @p.Numero" />
                                    </div>
                                }

                                <div class="row g-2 mt-2">
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded @(p.Correcta == "A" ? "border-success bg-success-subtle fw-bold" : "bg-body-tertiary")">
                                            <span><strong>A)</strong> @p.OpcionA</span>
                                            @if (p.Correcta == "A") { <span class="badge bg-success float-end">&check; Correcta</span> }
                                            @if (!string.IsNullOrWhiteSpace(p.ImagenA))
                                            {
                                                <div class="text-center mt-1"><img src="@p.ImagenA" class="img-fluid rounded border bg-white" style="max-height: 90px;" /></div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded @(p.Correcta == "B" ? "border-success bg-success-subtle fw-bold" : "bg-body-tertiary")">
                                            <span><strong>B)</strong> @p.OpcionB</span>
                                            @if (p.Correcta == "B") { <span class="badge bg-success float-end">&check; Correcta</span> }
                                            @if (!string.IsNullOrWhiteSpace(p.ImagenB))
                                            {
                                                <div class="text-center mt-1"><img src="@p.ImagenB" class="img-fluid rounded border bg-white" style="max-height: 90px;" /></div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded @(p.Correcta == "C" ? "border-success bg-success-subtle fw-bold" : "bg-body-tertiary")">
                                            <span><strong>C)</strong> @p.OpcionC</span>
                                            @if (p.Correcta == "C") { <span class="badge bg-success float-end">&check; Correcta</span> }
                                            @if (!string.IsNullOrWhiteSpace(p.ImagenC))
                                            {
                                                <div class="text-center mt-1"><img src="@p.ImagenC" class="img-fluid rounded border bg-white" style="max-height: 90px;" /></div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 border rounded @(p.Correcta == "D" ? "border-success bg-success-subtle fw-bold" : "bg-body-tertiary")">
                                            <span><strong>D)</strong> @p.OpcionD</span>
                                            @if (p.Correcta == "D") { <span class="badge bg-success float-end">&check; Correcta</span> }
                                            @if (!string.IsNullOrWhiteSpace(p.ImagenD))
                                            {
                                                <div class="text-center mt-1"><img src="@p.ImagenD" class="img-fluid rounded border bg-white" style="max-height: 90px;" /></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver al listado
    </a>
</div>

@section Scripts {
    <script>
        function exportarNotasCSV() {
            var rows = document.querySelectorAll("table tr");
            var csv = [];
            for (var i = 0; i < rows.length; i++) {
                var row = [], cols = rows[i].querySelectorAll("td, th");
                for (var j = 0; j < cols.length; j++) {
                    var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, "").trim();
                    row.push('"' + data.replace(/"/g, '""') + '"');
                }
                csv.push(row.join(","));
            }
            var csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            var downloadLink = document.createElement("a");
            downloadLink.download = "Notas_@(Model?.Titulo?.Replace(" ", "_") ?? "Evaluacion")_@(Model?.FechaInicio.ToString("yyyyMMdd") ?? "").csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);

            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }
    </script>
}
