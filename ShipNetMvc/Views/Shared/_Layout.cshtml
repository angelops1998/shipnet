@using ShipNetMvc.Models
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UPDS ShipNet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('shipnet-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-shipnet">
            <div class="container-xl px-3 px-md-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">UPDS</span>
                    <span>ShipNet</span>
                </a>

                <div class="d-flex align-items-center order-lg-3 ms-auto ms-lg-3 gap-2">
                    <!-- Botón de Modo Oscuro / Claro -->
                    <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Cambiar a Modo Oscuro / Claro" aria-label="Cambiar tema">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>

                    <span class="modulo-pill d-none d-md-inline-flex">
                        <i class="bi bi-calendar-event me-1"></i>
                        @UpdsCalendario.ModuloActual.Nombre
                    </span>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>
                                <span class="d-none d-md-inline">@User.Identity.Name?.Split('@')[0]</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger rounded-pill" style="font-size: 0.65rem;">Admin</span>
                                }
                                else if (User.IsInRole("Docente"))
                                {
                                    <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.65rem;">Docente</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark rounded-pill" style="font-size: 0.65rem;">Est.</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li class="px-3 py-2">
                                    <div class="fw-semibold small text-dark">@User.Identity.Name</div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <small class="text-muted">Administrador</small>
                                    }
                                    else if (User.IsInRole("Docente"))
                                    {
                                        <small class="text-muted">Docente</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Estudiante</small>
                                    }
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Calendario"><i class="bi bi-calendar3 me-2"></i>Calendario UPDS 2026</a></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-upds-cyan" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    }

                    <button class="navbar-toggler text-white border-0 ms-1" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarShipNet" aria-controls="navbarShipNet"
                            aria-expanded="false" aria-label="Navegación">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </div>

                <div class="collapse navbar-collapse order-lg-2" id="navbarShipNet">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Inicio
                            </a>
                        </li>

                        @if (User.IsInRole("Docente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Asistencia" asp-action="Index">
                                    <i class="bi bi-clipboard-check me-1"></i>Asistencia
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Evaluaciones" asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i>Evaluaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Grupos" asp-action="Index">
                                    <i class="bi bi-layers me-1"></i>Mis Materias
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Estudiante"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Asistencia" asp-action="Marcar">
                                    <i class="bi bi-qr-code-scan me-1"></i>Marcar Asistencia
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Asistencia" asp-action="Historial">
                                    <i class="bi bi-clock-history me-1"></i>Mis Asistencias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Evaluaciones" asp-action="Disponibles">
                                    <i class="bi bi-pencil-square me-1"></i>Evaluaciones
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Panel
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-people me-1"></i>Gestión
                                </a>
                                <ul class="dropdown-menu shadow-sm">
                                    <li><a class="dropdown-item" asp-controller="Docentes" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Docentes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Estudiantes"><i class="bi bi-people me-2"></i>Estudiantes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Grupos" asp-action="Index"><i class="bi bi-layers me-2"></i>Grupos / Módulos</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Carreras" asp-action="Index"><i class="bi bi-mortarboard me-2"></i>Carreras</a></li>
                                    <li><a class="dropdown-item" asp-controller="Materias" asp-action="Index"><i class="bi bi-book me-2"></i>Materias</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Macs"><i class="bi bi-hdd-network me-2"></i>MACs Estudiantes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Equipos" asp-action="Index"><i class="bi bi-pc-display me-2"></i>Equipos Lab.</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-bar-chart me-1"></i>Supervisar
                                </a>
                                <ul class="dropdown-menu shadow-sm">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Asistencias"><i class="bi bi-clipboard-data me-2"></i>Asistencias</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Examenes"><i class="bi bi-journal-check me-2"></i>Exámenes</a></li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Calendario">
                                <i class="bi bi-calendar3 me-1"></i>Calendario
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl px-3 px-md-4 py-4 main-container">
        <partial name="_Alertas" />
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-shipnet">
        <div class="container-xl px-3 px-md-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <strong>Universidad Privada Domingo Savio</strong> &bull; Sede Cochabamba, Bolivia
                <div class="text-white-50 small">ShipNet &mdash; Sistema de Control Modular de Asistencia por Validación MAC</div>
            </div>
            <div class="text-md-end text-white-50 small">
                <span>Gestión Académica Presencial 2026</span> &bull;
                <a asp-controller="Admin" asp-action="Calendario" style="color:rgba(255,255,255,.5)">Ver Calendario de Módulos</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function() {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');
            
            function syncIcon(theme) {
                if (!themeIcon) return;
                if (theme === 'dark') {
                    themeIcon.className = 'bi bi-sun-fill text-warning';
                    if (toggleBtn) toggleBtn.title = 'Cambiar a Modo Claro';
                } else {
                    themeIcon.className = 'bi bi-moon-stars-fill text-white';
                    if (toggleBtn) toggleBtn.title = 'Cambiar a Modo Oscuro';
                }
            }

            const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
            syncIcon(current);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    const activeTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
                    const nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-bs-theme', nextTheme);
                    localStorage.setItem('shipnet-theme', nextTheme);
                    syncIcon(nextTheme);
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>