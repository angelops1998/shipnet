@{
    var mensaje = TempData["Mensaje"] as string;
    var tipo = TempData["TipoMensaje"] as string ?? "info";

    var claseAlerta = tipo switch
    {
        "success" => "alert-success",
        "danger" => "alert-danger",
        "warning" => "alert-warning",
        _ => "alert-info"
    };

    var icono = tipo switch
    {
        "success" => "✔",
        "danger" => "✖",
        "warning" => "⚠",
        _ => "ℹ"
    };
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @claseAlerta alert-dismissible fade show d-flex align-items-center" role="alert">
        <span class="me-2 fw-bold">@icono</span>
        <div>@mensaje</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}