@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 style="color: var(--bs-primary);">ShipNet</h1>
    <p class="lead">Asistencia automática y evaluaciones seguras en el laboratorio.</p>
</div>

<div class="row g-3 justify-content-center">
    @if (User.IsInRole("Docente"))
    {
        <div class="col-md-4">
            <div class="card card-sesion">
                <div class="card-header">Docente</div>
                <div class="card-body">
                    <p class="card-text">Abre sesiones de asistencia y revisa quién marcó.</p>
                    <a asp-controller="Asistencia" asp-action="Index" class="btn btn-primary btn-sm">Ir a asistencia</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Estudiante"))
    {
        <div class="col-md-4">
            <div class="card card-sesion">
                <div class="card-header">Estudiante</div>
                <div class="card-body">
                    <p class="card-text">Marca tu asistencia desde una PC autorizada del laboratorio.</p>
                    <a asp-controller="Asistencia" asp-action="Marcar" class="btn btn-primary btn-sm">Marcar asistencia</a>
                </div>
            </div>
        </div>
    }
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <div class="card card-equipo">
                <div class="card-header">Administrador</div>
                <div class="card-body">
                    <p class="card-text">Gestiona equipos, materias y grupos.</p>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-sm">Ir a administración</a>
                </div>
            </div>
        </div>
    }
    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <div class="col-md-5 text-center">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Registrarme</a>
        </div>
    }
</div>