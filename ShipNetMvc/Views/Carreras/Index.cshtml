@model List<ShipNetMvc.Models.CarreraDto>
@{
    ViewData["Title"] = "Carreras Universitarias";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var facultades = Model.GroupBy(c => c.Facultad).OrderBy(g => g.Key).ToList();
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-mortarboard me-2" style="color:var(--upds-azul)"></i>Carreras UPDS
            </h2>
            <p class="text-muted mb-0">Oferta académica de la Universidad Privada Domingo Savio</p>
        </div>
        <a href="@Url.Action("Crear", "Carreras")" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Nueva Carrera
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-@TempData["TipoMensaje"] alert-dismissible fade show shadow-sm" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-auto">
            <div class="px-4 py-3 rounded-3 d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#002855,#004080);color:white">
                <i class="bi bi-mortarboard fs-4"></i>
                <div>
                    <div class="fw-bold fs-4">@Model.Count</div>
                    <small class="opacity-75">Carreras Registradas</small>
                </div>
            </div>
        </div>
        <div class="col-auto">
            <div class="px-4 py-3 rounded-3 d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#0099da,#006fa3);color:white">
                <i class="bi bi-building fs-4"></i>
                <div>
                    <div class="fw-bold fs-4">@facultades.Count</div>
                    <small class="opacity-75">Facultades</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Cards by Faculty -->
    @foreach (var facultad in facultades)
    {
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <div style="width:4px;height:24px;background:var(--upds-azul);border-radius:2px"></div>
                <h5 class="fw-bold mb-0 text-dark">@facultad.Key</h5>
                <span class="badge rounded-pill" style="background:var(--upds-azul-claro)">@facultad.Count()</span>
            </div>
            <div class="row g-3">
                @foreach (var c in facultad.OrderBy(x => x.Nombre))
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100 @(c.Activa ? "" : "opacity-50")">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-start justify-content-between mb-2">
                                    <div>
                                        <span class="badge rounded-pill mb-2" style="background:var(--upds-azul);font-size:.7rem">@c.Codigo</span>
                                        <h6 class="fw-bold mb-1" style="font-size:.9rem">@c.Nombre</h6>
                                        <small class="text-muted">@c.Duracion semestres</small>
                                    </div>
                                    <span class="badge @(c.Activa ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                        @(c.Activa ? "Activa" : "Inactiva")
                                    </span>
                                </div>
                                <div class="d-flex gap-1 mt-2 pt-2 border-top">
                                    <a href="@Url.Action("Editar", "Carreras", new { id = c.Id })"
                                       class="btn btn-sm btn-outline-primary flex-fill">
                                        <i class="bi bi-pencil me-1"></i>Editar
                                    </a>
                                    <a href="@Url.Action("Eliminar", "Carreras", new { id = c.Id })"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('¿Eliminar la carrera @c.Nombre?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-mortarboard display-1 text-muted opacity-25 d-block mb-3"></i>
            <p class="text-muted">No hay carreras registradas aún.</p>
        </div>
    }
